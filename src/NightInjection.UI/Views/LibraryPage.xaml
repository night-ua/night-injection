<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Name="RootPage"
    x:Class="NightInjection.UI.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:NightInjection.UI.Converters">
    <Page.Resources><converters:PathToImageSourceConverter x:Key="PathToImage"/></Page.Resources>
    <Grid Padding="{StaticResource PagePadding}" RowSpacing="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid>
            <StackPanel><TextBlock Text="Steam Library" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="Managed AppIDs discovered from the configured Steam folders." Style="{StaticResource SecondaryTextStyle}"/></StackPanel>
            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Command="{Binding ForceRefreshCommand}" Style="{StaticResource ToolbarButtonStyle}"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72C;"/><TextBlock Text="Refresh"/></StackPanel></Button>
        </Grid>
        <Grid Grid.Row="1" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
            <AutoSuggestBox PlaceholderText="Search name or AppID" QueryIcon="Find" Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <ComboBox Grid.Column="1" Header="Sort" ItemsSource="{Binding SortModes}" SelectedItem="{Binding SortMode, Mode=TwoWay}"/>
        </Grid>
        <InfoBar Grid.Row="2" IsOpen="{Binding HasStatus}" Message="{Binding StatusMessage}" IsClosable="False"/>
        <Grid Grid.Row="3">
            <ProgressRing IsActive="{Binding IsBusy}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <GridView ItemsSource="{Binding Items}" SelectionMode="None" IsItemClickEnabled="False" Padding="0,8,0,16">
                <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid MaximumRowsOrColumns="0" Orientation="Horizontal"/></ItemsPanelTemplate></GridView.ItemsPanel>
                <GridView.ItemTemplate><DataTemplate><Border Width="220" MinHeight="310" Margin="0,0,12,12" Style="{StaticResource CompactCardStyle}">
                    <Grid RowSpacing="10"><Grid.RowDefinitions><RowDefinition Height="190"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border CornerRadius="8" Background="{ThemeResource ControlFillColorSecondaryBrush}"><Image Source="{Binding CoverPath, Converter={StaticResource PathToImage}}" Stretch="UniformToFill" AutomationProperties.Name="Game cover"/></Border>
                        <TextBlock Grid.Row="1" Text="{Binding Name}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" MaxLines="2"/>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8"><TextBlock Text="AppID" Style="{StaticResource CaptionTextBlockStyle}"/><TextBlock Text="{Binding AppId}"/></StackPanel>
                        <Grid Grid.Row="3"><StackPanel><TextBlock Text="{Binding Status}" Style="{StaticResource CaptionTextBlockStyle}"/><TextBlock Text="{Binding LastProcessed}" Style="{StaticResource CaptionTextBlockStyle}"/></StackPanel>
                            <Button HorizontalAlignment="Right" Command="{Binding DataContext.RemoveCommand, ElementName=RootPage}" CommandParameter="{Binding}" Style="{StaticResource IconButtonStyle}" AutomationProperties.Name="Remove AppID"><FontIcon Glyph="&#xE74D;"/></Button></Grid>
                    </Grid>
                </Border></DataTemplate></GridView.ItemTemplate>
            </GridView>
        </Grid>
    </Grid>
</Page>
