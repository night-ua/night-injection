<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Name="RootPage"
    x:Class="NightInjection.UI.Views.LogsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="{StaticResource PagePadding}" RowSpacing="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid><StackPanel><TextBlock Text="Logs" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="User-readable events. Full exception details remain in the local log file." Style="{StaticResource SecondaryTextStyle}"/></StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8"><Button Command="{Binding ExportCommand}" Style="{StaticResource ToolbarButtonStyle}"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xEDE1;"/><TextBlock Text="Export"/></StackPanel></Button><Button Command="{Binding ClearCommand}" Style="{StaticResource ToolbarButtonStyle}"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE74D;"/><TextBlock Text="Clear view"/></StackPanel></Button></StackPanel></Grid>
        <Grid Grid.Row="1" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <AutoSuggestBox PlaceholderText="Search messages or categories" Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" QueryIcon="Find"/>
            <ComboBox Grid.Column="1" ItemsSource="{Binding LevelFilters}" SelectedItem="{Binding LevelFilter, Mode=TwoWay}"/>
            <ToggleSwitch Grid.Column="2" Header="Auto scroll" IsOn="{Binding AutoScroll, Mode=TwoWay}"/>
        </Grid>
        <InfoBar Grid.Row="2" IsOpen="{Binding HasStatus}" Message="{Binding StatusMessage}" IsClosable="False"/>
        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="8">
            <ListView x:Name="LogList" ItemsSource="{Binding Entries}" SelectionMode="Single" SelectionChanged="OnSelectionChanged">
                <ListView.ItemTemplate><DataTemplate><Grid Padding="5,8" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="165"/><ColumnDefinition Width="100"/><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Timestamp}" Style="{StaticResource CaptionTextBlockStyle}"/><TextBlock Grid.Column="1" Text="{Binding Level}"/><TextBlock Grid.Column="2" Text="{Binding Category}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="3" Text="{Binding Message}" TextWrapping="Wrap"/><Button Grid.Column="4" Command="{Binding DataContext.CopyCommand, ElementName=RootPage}" CommandParameter="{Binding}" Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="Copy"><FontIcon Glyph="&#xE8C8;"/></Button>
                </Grid></DataTemplate></ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</Page>
