<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="NavigationPaneColor">#A8F3F5F8</Color>
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#CFFFFFFF" />
            <SolidColorBrush x:Key="CardStrokeBrush" Color="#16000000" />
            <SolidColorBrush x:Key="CardHoverBrush" Color="#E8FFFFFF" />
            <SolidColorBrush x:Key="SubtlePanelBrush" Color="#70FFFFFF" />
            <SolidColorBrush x:Key="BrandIconBackgroundBrush" Color="#1F0067C0" />
            <SolidColorBrush x:Key="DropZoneBackgroundBrush" Color="#120067C0" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#107C10" />
            <SolidColorBrush x:Key="WarningBrush" Color="#9D5D00" />
            <SolidColorBrush x:Key="DangerBrush" Color="#C42B1C" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="NavigationPaneColor">#8212151C</Color>
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#A82A2E3A" />
            <SolidColorBrush x:Key="CardStrokeBrush" Color="#18FFFFFF" />
            <SolidColorBrush x:Key="CardHoverBrush" Color="#C7343947" />
            <SolidColorBrush x:Key="SubtlePanelBrush" Color="#66212630" />
            <SolidColorBrush x:Key="BrandIconBackgroundBrush" Color="#2BFF7A18" />
            <SolidColorBrush x:Key="DropZoneBackgroundBrush" Color="#1FFF7A18" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#6CCB5F" />
            <SolidColorBrush x:Key="WarningBrush" Color="#FCE100" />
            <SolidColorBrush x:Key="DangerBrush" Color="#FF99A4" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <Color x:Key="NavigationPaneColor">{ThemeResource SystemColorWindowColor}</Color>
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="CardStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="CardHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="SubtlePanelBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="BrandIconBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="DropZoneBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SuccessBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="WarningBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="DangerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
